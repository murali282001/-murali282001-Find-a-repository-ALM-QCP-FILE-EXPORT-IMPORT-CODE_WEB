# ─── QCP Web App Environment Variables ───────────────────────────────────────
# Copy this file to  .env  and fill in your values.
# The .env file is loaded automatically on startup.
#
# NOTE: Credentials are entered by users in the browser — this file is for
#       server-level configuration only (host, port, allowed origins, etc.)

# Host and port the server listens on
HOST=0.0.0.0
PORT=8000

# Optional: restrict which origins can access the API (comma-separated)
# Leave blank to allow all origins (fine for internal/intranet use)
ALLOWED_ORIGINS=

# Optional: set to "production" to disable auto-reload
ENV=development
